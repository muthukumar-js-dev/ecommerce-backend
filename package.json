{
  "name": "profitcart-nodejs",
  "version": "1.0.0",
  "description": "",
  "workspaces": [
    ".",
    "payment-service",
    "notification-service"
  ],
  "main": "app.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:prod": "tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "build:clean": "npm run clean && npm run build:prod",
    "build:watch": "tsc -w -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "dev:payment": "npm run dev --workspace=payment-service",
    "dev:notification": "npm run dev --workspace=notification-service",
    "dev:all": "concurrently -n \"MAIN,PAYMENT,NOTIF\" -c \"cyan,magenta,green\" \"npm run dev\" \"npm run dev:payment\" \"npm run dev:notification\"",
    "dev:services": "concurrently -n \"PAYMENT,NOTIF\" -c \"magenta,green\" \"npm run dev:payment\" \"npm run dev:notification\"",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm run format:check",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest src/shared/__tests__",
    "test:integration": "jest tests/integration",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:verbose": "jest --verbose",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:performance": "jest tests/performance --testTimeout=30000",
    "test:domain": "jest tests/unit/domain --coverage",
    "test:cqrs": "jest tests/integration/cqrs",
    "test:contract": "jest tests/contract --testTimeout=30000",
    "test:kafka": "jest tests/integration/kafka --testTimeout=30000",
    "test:outbox": "jest tests/integration/messaging --testTimeout=30000",
    "test:consumer": "jest tests/integration/messaging/kafka-consumer.test.ts --testTimeout=30000",
    "test:chaos": "jest tests/chaos --testTimeout=60000",
    "test:e2e": "playwright test tests/e2e",
    "test:load": "artillery run performance/order-placement.yml --output performance/report.json",
    "test:load:report": "artillery report performance/report.json --output performance/report.html"
  },
  "author": "Muthu",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.971.0",
    "@aws-sdk/client-s3": "^3.971.0",
    "@aws-sdk/s3-request-presigner": "^3.971.0",
    "@kafkajs/confluent-schema-registry": "^3.9.0",
    "aws-sdk": "^2.1687.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.2.0",
    "ioredis": "^5.9.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mock-aws-s3": "^4.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "nock": "^13.5.5",
    "sharp": "^0.34.5",
    "stripe": "^14.11.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@jest/globals": "^30.2.0",
    "@pact-foundation/pact": "^16.0.4",
    "@playwright/test": "^1.57.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jaeger-client": "^3.18.7",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "ajv": "^8.17.1",
    "artillery": "^2.0.21",
    "babel-loader": "^9.1.3",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "html-loader": "^5.1.0",
    "jest": "^30.2.0",
    "js-yaml": "^4.1.1",
    "mongodb-memory-server": "^11.0.1",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  }
}
