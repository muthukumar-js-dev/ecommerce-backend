{
  "consumer": {
    "name": "core-service"
  },
  "interactions": [
    {
      "description": "a request to send email",
      "providerStates": [
        {
          "name": "user exists with valid email"
        }
      ],
      "request": {
        "body": {
          "data": {
            "orderNumber": "ORD-001",
            "totalAmount": 1000
          },
          "subject": "Order Confirmation",
          "template": "order-confirmation",
          "to": "user@example.com"
        },
        "headers": {
          "Authorization": "Bearer token123",
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data.orderNumber": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.totalAmount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.subject": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.template": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.to": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/notifications/email"
      },
      "response": {
        "body": {
          "channel": "EMAIL",
          "notificationId": "notif-123",
          "status": "SENT"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.notificationId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.0.4"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "notification-service"
  }
}